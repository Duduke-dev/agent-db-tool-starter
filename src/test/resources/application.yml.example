# ============================================================================
# 这是模板文件，不是可直接使用的配置。
#
#   cp application.yml.example application.yml
#   然后按你的环境改端口、账号、密码
#
# application.yml 已被 .gitignore 忽略 —— 它带着真实凭据，不该进版本库。
# ============================================================================

spring:
  datasource:
    # 应用使用的连接。生产环境请确保这里配的是只读账号：
    # 它是「应用层有 bug 也写不进去」的最后一道防线。
    url: "jdbc:postgresql://localhost:5432/agentdb?ApplicationName=agent-db-tool"
    driver-class-name: org.postgresql.Driver
    username: agent_ro
    password: "改成只读账号的密码"
    hikari:
      pool-name: agent-readonly-pool
      maximum-pool-size: 5
      # 用 JDBC 的 setReadOnly 而不是写死某个方言的 SQL，换库时这行不用改
      read-only: true

  jooq:
    sql-dialect: postgres

  sql:
    init:
      # 表由管理员账号建一次；应用连的是只读账号，本来就没有 DDL 权限
      mode: never

agent-db:
  # 启动时建授权表并扫描登记清单用的管理员凭据。
  # 生产环境建议 enabled: false，把建表交给 migration；
  # 密码用环境变量传，别写死在文件里。
  bootstrap:
    enabled: true
    username: postgres
    password: "${AGENT_DB_BOOTSTRAP_PASSWORD}"

  # 仅供测试：授权变更类测试要模拟「有人改授权表」，那是 DBA 的动作，用管理员连接。
  test:
    admin-username: postgres
    admin-password: "${AGENT_DB_TEST_ADMIN_PASSWORD}"

logging:
  level:
    com.duduke.agentdb: DEBUG
